---
interface Props { eyebrow: string; title: string; description: string; image?: string; imageAlt?: string; }
const { eyebrow, title, description, image, imageAlt = '' } = Astro.props;
---
<section class:list={['page-hero', 'page-hero--small', { 'page-hero--illustrated': image }]}><div class="container page-hero-inner" data-reveal="fade-up">
  <div class="page-hero-copy"><p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p>{description}</p><slot /></div>
  {image && <div class="page-hero-art"><span class="page-hero-orbit"></span><img src={image} alt={imageAlt} width="1256" height="1256" loading="eager" /></div>}
</div></section>
