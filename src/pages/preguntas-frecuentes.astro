---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/shared/PageIntro.astro';
import EditorialLink from '../components/shared/EditorialLink.astro';
import { sessionFaqs as faqs } from '../data/sessionFaqs';
---
<BaseLayout title="Preguntas sobre psicoterapia en línea" description="Respuestas sobre la primera sesión, la modalidad por videollamada y cómo iniciar psicoterapia en línea en México con Fernanda Hernández.">
  <PageIntro eyebrow="Dudas comunes" title="Preguntas frecuentes" description="Algunas respuestas para ayudarte a dar el primer paso con más claridad." image="/assets/03-ilustraciones-principales/ilustracion-psicologa-3.webp" imageAlt="Ilustración serena que acompaña la información sobre terapia" />
  <section class="section section--sage"><div class="container faq-list">{faqs.map(({id,q,a}) => <details id={id}><summary>{q}</summary><p>{a}</p></details>)}</div></section>
  <section class="section final-cta"><div class="container"><h2>¿Hay algo más que te gustaría <em>preguntar?</em></h2><EditorialLink href="/contacto/" label="Ir a contacto" accent /></div></section>
</BaseLayout>
